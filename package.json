{
  "name": "zenless-solution",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "data:build": "python tools/import_phoenix.py && python tools/import_codex.py && python tools/import_panel.py",
    "data:check": "python tools/check_data.py",
    "assets:sync": "python tools/sync_assets.py",
    "assets:check": "python tools/check_assets.py",
    "verify": "pnpm data:check && pnpm assets:check && pnpm test && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.1.0",
    "vue-tsc": "^2.2.0"
  }
}
